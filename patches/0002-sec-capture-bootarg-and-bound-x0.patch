--- a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
+++ b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
@@ -8,6 +8,11 @@ ASM_FUNC (_ModuleEntryPoint)
   // Do Platform Specific Initialization
+  // Preserve the incoming ARM64 x0 boot argument before platform setup.
+  // x19 is callee-saved by the AAPCS64 ABI and survives the calls below.
+  // Its meaning is intentionally opaque here; SEC validates its range
+  // before treating it as a possible device-tree pointer.
+  mov   x19, x0
   bl    ASM_PFX (PlatformAssemblyInitialize)
@@ -39,10 +44,12 @@ MainEntryPoint:
   // Set Jump Location
-  ldr   x0, =ASM_PFX (SecEntry)
+  ldr   x16, =ASM_PFX (SecEntry)
 
   // Clear Frame Pointer
   mov   x29, xzr
 
-  // Jump to C Code
-  blr   x0
+  // Pass the captured incoming x0 as the first C argument.
+  mov   x0, x19
+
+  // Jump to C Code (x16 holds the function address).
+  blr   x16
 
   // Do Infinite Spin
   b     .

diff --git a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
index 0000000..0000000 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
+++ b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
@@ -13,6 +13,7 @@
 #include <Library/MemoryMapHelperLib.h>
+#include <Library/MemoryMapLib.h>
 #include <Library/TimerLib.h>
 #include <Library/HobLib.h>
 
 #include "Sec.h"
 
+//
+// The initial x0 value is opaque until checked against the platform's
+// reviewed physical-memory descriptors. Do not dereference it here.
+//
+STATIC
+BOOLEAN
+IsBootArgument0InKnownDram (
+  IN UINTN  Address
+  )
+{
+  EFI_MEMORY_REGION_DESCRIPTOR  *Regions;
+  UINT8                         RegionCount;
+  UINT8                         Index;
+  UINTN                         RegionBase;
+  UINTN                         RegionLength;
+
+  // The AArch64 device-tree blob header is 8-byte aligned and at least
+  // 40 bytes long. This check establishes only that x0 could point into
+  // a known DRAM region; it does not prove that x0 is a DTB.
+  if ((Address == 0) || ((Address & 7) != 0) || (Address > MAX_UINTN - 40)) {
+    return FALSE;
+  }
+
+  GetMemoryMap (&Regions, &RegionCount);
+  if ((Regions == NULL) || (RegionCount == 0)) {
+    return FALSE;
+  }
+
+  for (Index = 0; Index < RegionCount; Index++) {
+    if ((Regions[Index].ResourceType != EFI_RESOURCE_SYSTEM_MEMORY) &&
+        (Regions[Index].ResourceType != EFI_RESOURCE_MEMORY_RESERVED))
+    {
+      continue;
+    }
+
+    if ((Regions[Index].Address > MAX_UINTN) ||
+        (Regions[Index].Length > MAX_UINTN))
+    {
+      continue;
+    }
+
+    RegionBase   = (UINTN)Regions[Index].Address;
+    RegionLength = (UINTN)Regions[Index].Length;
+    if ((RegionLength < 40) || (RegionBase > MAX_UINTN - RegionLength)) {
+      continue;
+    }
+
+    if ((Address >= RegionBase) &&
+        (Address <= (RegionBase + RegionLength - 40)))
+    {
+      return TRUE;
+    }
+  }
+
+  return FALSE;
+}
+
 STATIC
 VOID
 PrintFirmwareVersion (VOID)
@@ -61,9 +109,9 @@ InitializeMemory (VOID)
 STATIC
 VOID
-SecMain (VOID)
+SecMain (IN UINTN BootArgument0)
 {
   EFI_STATUS Status;
 
@@ -87,6 +135,18 @@ SecMain (VOID)
     return;
   }
 
+  // MemoryPeim has established the platform memory map. Check only whether
+  // the captured value lies wholly within one declared DRAM descriptor.
+  // Do not parse or dereference it until the platform's mapping and
+  // bootloader handoff contract have been independently verified.
+  if (IsBootArgument0InKnownDram (BootArgument0)) {
+    DEBUG ((EFI_D_INFO, "SEC: incoming x0=0x%lx is inside a known DRAM region; DTB identity remains unverified.\n", (UINT64)BootArgument0));
+  } else {
+    DEBUG ((EFI_D_WARN, "SEC: incoming x0=0x%lx is not a validated DRAM pointer; not dereferencing.\n", (UINT64)BootArgument0));
+  }
+
   // Build CPU HOB
   BuildCpuHob (ArmGetPhysicalAddressBits (), PcdGet8 (PcdPrePiCpuIoSize));
@@ -129,7 +189,7 @@ SecMain (VOID)
 }
 
